# Скопируйте в .env.production на сервере и заполните значения (файл с секретами не коммитить).

NODE_ENV=production

# PostgreSQL (production). Для Yandex Managed PostgreSQL обычно нужен sslmode=require; порт смотрите в консоли облака (часто 6432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/menarium_db?schema=public&sslmode=require

# Публичный URL приложения (с протоколом). После включения HTTPS — именно https://
NEXTAUTH_URL=https://menarium.ru

# Сгенерируйте длинную случайную строку (например openssl rand -base64 32)
NEXTAUTH_SECRET=replace_with_long_random_secret

# Опционально: вход через Google (если оба заданы — провайдер включается)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Опционально: Yandex Object Storage (если используете загрузку файлов в облако)
# STORAGE_ENDPOINT=https://storage.yandexcloud.net
# STORAGE_BUCKET=menarium-prod
# STORAGE_REGION=ru-central1
# STORAGE_ACCESS_KEY_ID=replace_me
# STORAGE_SECRET_ACCESS_KEY=replace_me
